{
  "manifest_version": 3,
  "name": "Lazy Apply Autofill",
  "description": "识别网页表单字段并根据本地个人资料进行预览和自动填充。",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lazy Apply"
  },
  "permissions": ["storage", "activeTab", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
